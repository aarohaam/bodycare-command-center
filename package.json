{
  "name": "bodycare-product-command-centre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build && node scripts/create-static-host-entry.mjs",
    "build:pages": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build --base=./ --mode public",
    "package:sites": "npm run build && node scripts/package-static-site.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
